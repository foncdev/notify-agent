# notify-agent 설정. ~/.config/notify-agent/env 에 두고 권한을 600으로 한다.

# relay-service 주소. 같은 맥이면 그대로 둔다.
NOTIFY_RELAY_URL=http://127.0.0.1:4100

# relay-service의 RELAY_HOOK_KEY와 같은 값(24자 이상). 알림 추가만 할 수 있는 키다.
NOTIFY_HOOK_KEY=

# 가져올 앱의 번들 id(쉼표로). 비우면 아무것도 보내지 않는다. `notify-agent apps`로 고른다.
# 예: com.kakao.KakaoTalkMac,com.tinyspeck.slackmacgap
NOTIFY_APPS=

# 알림 기록을 들여다보는 간격.
NOTIFY_POLL=5s

# 글 언어. ko(기본) 또는 en. 시험 알림과 명령줄 출력·오류가 이 언어를 따른다.
# relay-service의 RELAY_LANG, 폰 앱의 언어와 같게 둔다.
RELAY_LANG=ko
